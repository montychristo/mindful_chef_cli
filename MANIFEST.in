include LICENSE README.md pyproject.toml AGENTS.md CLAUDE.md
recursive-include integrations *.example
recursive-include skills *.md *.yaml
recursive-include docs *.md
recursive-include examples *.example.json
recursive-include scripts *.py
recursive-include tests *.py
prune .venv
prune private
prune state
prune .state
global-exclude *.pyc *.har *.log .DS_Store
